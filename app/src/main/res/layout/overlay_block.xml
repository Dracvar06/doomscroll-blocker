<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately plain, and deliberately offers no way in. A pass is granted in
     Doorman itself, which means leaving the app you are being blocked from. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Overdraw"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1A16"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Text set at runtime: it names the screen that was blocked. -->
    <TextView
        android:id="@+id/blocked_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/blocked_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/blocked_body"
        android:textColor="#B7C9C0"
        android:textSize="16sp" />

    <Button
        android:id="@+id/blocked_go_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/action_go_back" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/blocked_hint_pass"
        android:textColor="#7E918A"
        android:textSize="14sp" />
</LinearLayout>
