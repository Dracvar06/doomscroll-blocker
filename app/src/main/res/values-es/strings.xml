<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="accessibility_service_description">Doorman mira qué pantalla tienes abierta en las aplicaciones que elijas, para poder tapar los flujos infinitos dejando intactos los mensajes, las búsquedas y los vídeos concretos.\n\nSolo lee la estructura de la pantalla — los nombres de los elementos que tienes delante. Nunca lee tus mensajes, contraseñas ni datos de la cuenta. No se guarda nada, y nunca sale nada de tu teléfono.</string>

    <string name="home_tagline">Los mensajes pasan. El flujo, no.</string>
    <string name="status_enabled">Doorman está activo</string>
    <string name="status_enabled_body">El bloqueo funciona para las pantallas que has activado.</string>
    <string name="status_disabled">Doorman está parado</string>
    <string name="status_disabled_body">Doorman necesita acceso de accesibilidad para ver qué pantalla tienes abierta. No se recoge nada de lo que escribes o lees.</string>
