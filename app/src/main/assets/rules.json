{
  "version": 1,
  "apps": {
    "com.google.android.youtube": {
      "labelKey": "app_youtube",
      "screens": [
        {
          "id": "yt_single_short",
          "labelKey": "screen_yt_single_short",
          "defaultEnabled": true,
          "verdict": "ALLOW_ONCE",
          "budget": 1,
          "match": {
            "anyViewId": [
              "reel_recycler",
              "reel_player_page_container"
            ],
            "noneViewId": [
              "pivot_bar"
            ]
          }
        },
        {
          "id": "yt_shorts",
          "labelKey": "screen_yt_shorts",
          "defaultEnabled": true,
          "match": {
            "anyViewId": [
              "reel_recycler",
              "reel_player_page_container"
            ]
          }
        },
        {
          "id": "yt_home_feed",
          "labelKey": "screen_yt_home",
          "defaultEnabled": true,
          "match": {
            "selectedTab": {
              "under": "pivot_bar",
              "index": 0
            },
            "noneViewId": [
              "reel_recycler",
              "watch_panel",
              "search_query"
            ]
          }
        },
        {
          "id": "yt_subscriptions_feed",
          "labelKey": "screen_yt_subscriptions",
          "defaultEnabled": false,
          "match": {
            "selectedTab": {
              "under": "pivot_bar",
              "index": 3
            },
            "noneViewId": [
              "reel_recycler",
              "watch_panel",
              "search_query"
            ]
          }
        }
      ],
      "keepVisibleViewIds": [
        "pivot_bar"
      ],
      "keepVisibleTopViewIds": [
        "toolbar"
      ]
    },
    "com.instagram.android": {
      "labelKey": "app_instagram",
      "screens": [
        {
          "id": "ig_single_reel",
          "labelKey": "screen_ig_single_reel",
          "defaultEnabled": true,
          "verdict": "ALLOW_ONCE",
          "budget": 1,
          "match": {
            "visibleViewId": [
              "clips_viewer_view_pager"
            ],
            "noneViewId": [
              "clips_tab"
            ]
          }
        },
        {
          "id": "ig_reels",
          "labelKey": "screen_ig_reels",
          "defaultEnabled": true,
          "match": {
            "selectedViewId": [
              "clips_tab"
            ]
          }
        },
        {
          "id": "ig_feed",
          "labelKey": "screen_ig_feed",
          "defaultEnabled": true,
          "match": {
            "selectedViewId": [
              "feed_tab"
            ]
          }
        },
        {
          "id": "ig_explore",
          "labelKey": "screen_ig_explore",
          "defaultEnabled": true,
          "match": {
            "selectedViewId": [
              "search_tab"
            ]
          }
        }
      ],
      "keepVisibleViewIds": [
        "feed_tab",
        "clips_tab",
        "direct_tab",
        "search_tab",
        "profile_tab"
      ],
      "keepVisibleTopViewIds": [
        "action_bar_search_edit_text"
      ]
    }
  }
}