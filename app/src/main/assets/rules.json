{
  "version": 1,
  "apps": {
    "com.google.android.youtube": {
      "labelKey": "app_youtube",
      "screens": [
        {
          "id": "yt_single_short",
          "labelKey": "screen_yt_single_short",
          "defaultEnabled": true,
          "verdict": "ALLOW_ONCE",
          "budget": 1,
          "match": {
            "anyViewId": [
              "reel_recycler",
              "reel_player_page_container"
            ],
            "noneViewId": [
              "pivot_bar"
            ]
          },
          "helpKey": "help_yt_single_short",
          "endless": true
        },
        {
          "id": "yt_shorts",
          "labelKey": "screen_yt_shorts",
          "defaultEnabled": true,
          "match": {
            "anyViewId": [
              "reel_recycler",
              "reel_player_page_container"
            ]
          },
          "helpKey": "help_yt_shorts",
          "endless": true
        },
        {
          "id": "yt_home_feed",
          "labelKey": "screen_yt_home",
          "defaultEnabled": true,
          "match": {
            "selectedTab": {
              "under": "pivot_bar",
              "index": 0
            },
            "noneViewId": [
              "reel_recycler",
              "watch_panel",
              "search_query"
            ]
          },
          "helpKey": "help_yt_home_feed"
        },
        {
          "id": "yt_subscriptions_feed",
          "labelKey": "screen_yt_subscriptions",
          "defaultEnabled": false,
          "match": {
            "selectedTab": {
              "under": "pivot_bar",
              "index": 3
            },
            "noneViewId": [
              "reel_recycler",
              "watch_panel",
              "search_query"
            ]
          },
          "helpKey": "help_yt_subscriptions_feed"
        }
      ],
      "keepVisibleViewIds": [
        "pivot_bar"
      ],
      "keepVisibleTopViewIds": [
        "toolbar"
      ]
    },
    "com.instagram.android": {
      "labelKey": "app_instagram",
      "screens": [
        {
          "id": "ig_single_reel",
          "labelKey": "screen_ig_single_reel",
          "defaultEnabled": true,
          "verdict": "ALLOW_ONCE",
          "budget": 1,
          "match": {
            "visibleViewId": [
              "clips_viewer_view_pager"
            ],
            "noneViewId": [
              "clips_tab"
            ]
          },
          "helpKey": "help_ig_single_reel",
          "endless": true
        },
        {
          "id": "ig_stories",
          "labelKey": "screen_ig_stories",
          "defaultEnabled": false,
          "verdict": "BLOCK",
          "match": {
            "visibleViewId": [
              "reel_viewer_root"
            ]
          },
          "helpKey": "help_ig_stories"
        },
        {
          "id": "ig_reels",
          "labelKey": "screen_ig_reels",
          "defaultEnabled": true,
          "match": {
            "selectedViewId": [
              "clips_tab"
            ]
          },
          "helpKey": "help_ig_reels",
          "endless": true
        },
        {
          "id": "ig_reel_viewer",
          "labelKey": "screen_ig_reel_viewer",
          "defaultEnabled": false,
          "match": {
            "visibleViewId": [
              "clips_viewer_view_pager"
            ]
          },
          "helpKey": "help_ig_reel_viewer"
        },
        {
          "id": "ig_feed",
          "labelKey": "screen_ig_feed",
          "defaultEnabled": true,
          "match": {
            "selectedViewId": [
              "feed_tab"
            ]
          },
          "keepVisibleTopViewIds": [
            "outer_container"
          ],
          "keepVisibleTopSuppressedBy": "ig_home_stories_tray",
          "helpKey": "help_ig_feed"
        },
        {
          "id": "ig_home_stories_tray",
          "labelKey": "screen_ig_home_stories_tray",
          "defaultEnabled": false,
          "helpKey": "help_ig_home_stories_tray"
        },
        {
          "id": "ig_explore",
          "labelKey": "screen_ig_explore",
          "defaultEnabled": true,
          "match": {
            "selectedViewId": [
              "search_tab"
            ]
          },
          "keepVisibleTopViewIds": [
            "action_bar_search_edit_text"
          ],
          "helpKey": "help_ig_explore",
          "endless": true
        }
      ],
      "keepVisibleViewIds": [
        "feed_tab",
        "clips_tab",
        "direct_tab",
        "search_tab",
        "profile_tab"
      ],
      "keepVisibleTopViewIds": [
        "action_bar_search_edit_text"
      ]
    },
    "com.zhiliaoapp.musically": {
      "labelKey": "app_tiktok",
      "aliases": [
        "com.ss.android.ugc.trill"
      ],
      "screens": [
        {
          "id": "tt_shared_video",
          "labelKey": "screen_tt_shared_video",
          "defaultEnabled": true,
          "verdict": "ALLOW_ONCE",
          "budget": 1,
          "match": {
            "visibleViewId": [
              "text1"
            ],
            "anyViewId": [
              "long_press_layout",
              "video_player_progress"
            ],
            "arrivedFromAnotherApp": true
          },
          "helpKey": "help_tt_shared_video",
          "endless": true
        },
        {
          "id": "tt_feed",
          "labelKey": "screen_tt_feed",
          "defaultEnabled": true,
          "match": {
            "visibleViewId": [
              "text1"
            ],
            "anyViewId": [
              "long_press_layout",
              "video_player_progress"
            ]
          },
          "helpKey": "help_tt_feed",
          "endless": true
        }
      ],
      "keepVisibleTopViewIds": [
        "text1"
      ],
      "keepVisibleBelowViewIds": [
        "viewpager"
      ]
    },
    "com.snapchat.android": {
      "labelKey": "app_snapchat",
      "screens": [
        {
          "id": "sc_spotlight",
          "labelKey": "screen_sc_spotlight",
          "defaultEnabled": true,
          "match": {
            "visibleViewId": [
              "favorite"
            ],
            "allViewId": [
              "ngs_spotlight_icon_container"
            ],
            "noneViewId": [
              "camera_capture_button",
              "df_large_story",
              "ff_item",
              "memories_grid"
            ]
          },
          "helpKey": "help_sc_spotlight",
          "endless": true
        },
        {
          "id": "sc_stories",
          "labelKey": "screen_sc_stories",
          "defaultEnabled": true,
          "match": {
            "visibleViewId": [
              "df_large_story"
            ]
          },
          "keepVisibleTopViewIds": [
            "friend_card_frame"
          ],
          "keepVisibleTopSuppressedBy": "sc_friends_story_row",
          "helpKey": "help_sc_stories"
        },
        {
          "id": "sc_friends_story_row",
          "labelKey": "screen_sc_friends_story_row",
          "defaultEnabled": false,
          "helpKey": "help_sc_friends_story_row"
        }
      ],
      "keepVisibleViewIds": [
        "ngs_map_icon_container",
        "ngs_chat_icon_container",
        "ngs_camera_icon_container",
        "ngs_community_icon_container",
        "ngs_spotlight_icon_container"
      ],
      "keepVisibleTopViewIds": [
        "hova_header_search_icon"
      ]
    }
  }
