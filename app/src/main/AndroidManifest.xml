<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Doorman needs to recognise the home screen, and nothing else.

      Whether the user arrived at TikTok by following a link or by opening it
      themselves is what separates a video a friend sent from the feed, and the
      launcher is the app that answers it. Since Android 11 an app cannot see
      other packages without saying which, and without this declaration the
      lookup comes back empty, and every deliberate visit would then look like a
      link and be waved through.

      This is deliberately one intent rather than QUERY_ALL_PACKAGES. Doorman
      has no network permission and no business knowing what else is installed.
    -->
    <!--
      Android 13 and later. Asked for only when the weekly report is switched
      on, and the report works without it: the tab is always there to open by
      hand. Doorman posts exactly one notification a week and nothing else.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android's own screen-time figures, for the one question Doorman cannot
      answer about itself: whether the phone got picked up less.

      Granted by hand from a list in Android's settings, never by a dialog, and
      offered only from inside the report. Everything else in the report works
      without it. Doorman reads it while drawing the report, only for the apps
      the user chose to hold, keeps none of it, and has no network permission
      to send it anywhere.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!--
          And the apps that have a launcher icon, so the user can pick one to
          hold and see its name and not its package.

          Doorman needs this for two things it cannot do otherwise. Android
          filters package visibility for the whole app, not per component, so
          without this even the accessibility service reads WhatsApp's name as
          "com.whatsapp". And a game cannot be picked from a list that cannot be
          read.

          This is the narrower of the two ways to ask. QUERY_ALL_PACKAGES is a
          restricted permission that Google Play reviews case by case; an intent
          declaration is not, and it reveals only apps with a launcher icon.
          Nothing about them leaves the phone: Doorman has no network
          permission at all.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:supportsRtl="true"
        android:theme="@style/Theme.Doorman">

        <activity
            android:name=".ui.MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets a diagnostics report be shared with another app. Redacted
             reports only; grantUriPermissions means the receiving app gets
             access to that one file and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Monday morning. Not exported: nothing outside Doorman has any
             business asking for the weekly report. -->
        <receiver
            android:name=".report.WeeklyReportReceiver"
            android:exported="false" />

        <!-- Fires once after each update. MY_PACKAGE_REPLACED is a protected
             broadcast only the system can send, and the system delivers it to
             a non-exported receiver, so exported stays false. -->
        <receiver
            android:name=".report.UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.DoormanAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
