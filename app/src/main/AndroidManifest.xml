<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Doorman needs to recognise the home screen, and nothing else.

      Whether the user arrived at TikTok by following a link or by opening it
      themselves is what separates a video a friend sent from the feed, and the
      launcher is the app that answers it. Since Android 11 an app cannot see
      other packages without saying which, and without this declaration the
      lookup comes back empty, and every deliberate visit would then look like a
      link and be waved through.

      This is deliberately one intent rather than QUERY_ALL_PACKAGES. Doorman
      has no network permission and no business knowing what else is installed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!--
          And the apps that have a launcher icon, so the user can pick one to
          hold and see its name and not its package.

          Doorman needs this for two things it cannot do otherwise. Android
          filters package visibility for the whole app, not per component, so
          without this even the accessibility service reads WhatsApp's name as
          "com.whatsapp". And a game cannot be picked from a list that cannot be
          read.

          This is the narrower of the two ways to ask. QUERY_ALL_PACKAGES is a
          restricted permission that Google Play reviews case by case; an intent
          declaration is not, and it reveals only apps with a launcher icon.
          Nothing about them leaves the phone: Doorman has no network
          permission at all.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:supportsRtl="true"
        android:theme="@style/Theme.Doorman">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets a diagnostics report be shared with another app. Redacted
             reports only; grantUriPermissions means the receiving app gets
             access to that one file and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.DoormanAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
